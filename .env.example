# Pulled by `neon deploy`. Use the pooled URL for application traffic and direct URL for migrations.
# DATABASE_URL=postgresql://...
# DATABASE_URL_UNPOOLED=postgresql://...
# NEON_BRANCH=production
# Required in production: absolute directory on a persistent disk for private screenshots.
# DATA_DIR=C:/Projects/achitpharma-social-marketing-team/data
# Set to the public HTTPS origin when deploying behind a proxy.
# APP_ORIGIN=https://team.example.com
# COOKIE_SECURE=true
# Required behind the production reverse proxy. Use a random 32+ character secret.
# TRUST_PROXY=true
# IP_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional absolute private file directory; defaults to DATA_DIR/files.
# PRIVATE_FILES_DIR=D:/Achitpharma/private-files
# Test automation only; accepted solely with an HTTP loopback APP_ORIGIN.
# ALLOW_INSECURE_LOCAL_ORIGIN=false
