{
  "name": "achitpharma-social-marketing-team",
  "version": "0.1.0",
  "private": true,
  "description": "Achitpharma social marketing team workspace",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "tsx scripts/db-migrate.ts",
    "dev": "next dev --hostname localhost --port 3000",
    "build": "next build",
    "prestart": "tsx scripts/validate-production-env.ts && tsx scripts/db-migrate.ts",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/integration.ts",
    "test:neon-smoke": "tsx scripts/neon-smoke.ts",
    "validate": "npm run typecheck && npm test && npm run build",
    "validate:integration": "npm run validate && npm run test:integration",
    "legacy:db:backup": "tsx scripts/db-backup.ts",
    "legacy:db:restore": "tsx scripts/db-restore.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:import-sqlite": "tsx scripts/migrate-sqlite-to-neon.ts",
    "ops:status": "tsx scripts/ops-status.ts",
    "ops:cleanup": "tsx scripts/ops-cleanup.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "lucide-react": "1.47.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3"
  }
}
